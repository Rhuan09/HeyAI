<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HeyAI.Server</RootNamespace>
    <AssemblyName>heyai</AssemblyName>
    <!-- NOT PackAsTool. NETSDK1146: PackAsTool rejects any TargetPlatformIdentifier,
         and this project needs net10.0-windows10.0.26100.0 to reference the WinRT
         modules. A net10.0 tool project cannot reference a windows-TFM project either,
         so there is no split that recovers it. Distribution is unresolved; see
         docs/ARCHITECTURE.md "Distribution". -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeyAI.Core\HeyAI.Core.csproj" />
    <ProjectReference Include="..\HeyAI.Modules.Media\HeyAI.Modules.Media.csproj" />
  </ItemGroup>
</Project>
